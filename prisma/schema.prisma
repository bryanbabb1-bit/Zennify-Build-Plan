// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum StoryType {
  FEATURE
  TASK
  SPIKE
}

model Project {
  id                String        @id @default(cuid())
  name              String
  clientName        String
  clientSubVertical String        @default("Banking")
  status            ProjectStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  inputs            ProjectInput[]
  outcomes          Outcome[]
  epics             Epic[]
  stories           Story[]
  solutionDesign    SolutionDesign?
  buildInstructions BuildInstruction[]
  shareTokens       ShareToken[]
  generationJobs    GenerationJob[]
}

model ProjectInput {
  id            String   @id @default(cuid())
  projectId     String
  type          String   // digital_maturity | sow_pdf | discovery_notes | tech_stack | hubbl_scan
  structuredData Json?
  textContent   String?
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  extractedText String?
  driveFileId   String?
  driveFileName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Outcome {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  category    String   // operational_efficiency | client_experience | compliance | revenue_growth
  priority    Priority @default(MEDIUM)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epics       Epic[]
}

model Epic {
  id          String   @id @default(cuid())
  projectId   String
  outcomeId   String?
  jiraKey     String?
  title       String
  description String
  sfClouds    String[]
  priority    Priority @default(MEDIUM)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outcome     Outcome? @relation(fields: [outcomeId], references: [id])
  stories     Story[]
  buildInstructions BuildInstruction[]
}

model Story {
  id                 String    @id @default(cuid())
  projectId          String
  epicId             String
  jiraKey            String?
  title              String
  userRole           String
  action             String
  benefit            String
  acceptanceCriteria Json
  type               StoryType @default(FEATURE)
  priority           Priority  @default(MEDIUM)
  storyPoints        Int?
  sfObjects          String[]
  sfFeatures         String[]
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic               Epic      @relation(fields: [epicId], references: [id], onDelete: Cascade)
}

model SolutionDesign {
  id                String   @id @default(cuid())
  projectId         String   @unique
  recommendedClouds Json?
  integrations      Json?
  customObjects     Json?
  dataArchitecture  Json?
  securityModel     Json?
  narrativeContent  Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BuildInstruction {
  id        String   @id @default(cuid())
  projectId String
  epicId    String?
  title     String
  content   String
  phase     String   // setup | config | integration | testing | deploy
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic      Epic?    @relation(fields: [epicId], references: [id])
}

model ShareToken {
  id              String    @id @default(cuid())
  projectId       String
  token           String    @unique @default(cuid())
  isActive        Boolean   @default(true)
  sectionsVisible Json      @default("{\"outcomes\":true,\"epics\":true,\"stories\":false,\"design\":false,\"build\":false}")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GenerationJob {
  id          String    @id @default(cuid())
  projectId   String
  type        String    // analysis | outcomes | epics_stories | solution_design | build_instructions
  status      String    @default("pending")
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StandardsDocument {
  id            String   @id @default(cuid())
  title         String
  category      String   // story_format | naming | delivery | architecture | financial_services
  extractedText String
  fileUrl       String?
  isActive      Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GoogleCredential {
  id           String   @id @default(cuid())
  clerkUserId  String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
